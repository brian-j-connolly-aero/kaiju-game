# Monster Battle 9001 hosting settings.
# Copy this file to a file named .env (in the same folder) and fill in what you need.
# The .env file stays on your computer: it is never shared or uploaded.
# Every line is optional. A line starting with # is a note and is ignored.

# The port for your own browser (http://localhost:2567). Change it only if 2567 is taken.
MB_PORT=2567

# Your own domain (named tunnel). Leave both empty to use the free quick tunnel instead.
# TUNNEL_TOKEN is the long code Cloudflare shows when you create the tunnel.
# MB_PUBLIC_URL is the address your friends will open, for example https://kaiju.example.com
# (just the address, nothing after it). The game uses it for the invite links it copies.
TUNNEL_TOKEN=
MB_PUBLIC_URL=
