{
  "name": "@mb/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Monster Battle 9001 shared code: math, definitions, city, simulation, network protocol. Pure TypeScript, no DOM and no Node APIs.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "sim": "tsx scripts/sim.ts",
    "export:defs": "tsx scripts/export-defs.ts"
  }
}
